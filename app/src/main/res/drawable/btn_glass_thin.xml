<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF"/> <!-- More transparent on press -->
            <stroke android:width="1dp" android:color="#80FFFFFF"/>
            <corners android:radius="16dp"/> <!-- Slimmer corners -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF"/> <!-- Semi-transparent background -->
            <stroke android:width="1dp" android:color="#80FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</selector>
