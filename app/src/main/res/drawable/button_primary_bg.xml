<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:angle="90" android:startColor="#B71C1C" android:endColor="#D32F2F"/>
            <stroke android:width="1dp" android:color="#FF5252"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <gradient android:angle="90" android:startColor="#D32F2F" android:endColor="#A31B1B"/>
                </shape>
            </item>
            <item android:bottom="50%">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"/>
                    <gradient android:angle="90" android:startColor="#30FFFFFF" android:endColor="#00FFFFFF"/>
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <stroke android:width="1dp" android:color="#FF5252"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
