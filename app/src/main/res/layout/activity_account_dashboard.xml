<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background"
    android:animateLayoutChanges="true">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:background="@color/sidebar_bg"
        android:paddingHorizontal="16dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Account & Preview" android:textColor="@color/text"
            android:textSize="20sp" android:textStyle="bold"/>
        <ImageView android:id="@+id/btnMenuOptions" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_more" android:tint="@color/text_secondary"
            android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- Preview -->
    <com.fearlauncher.app.view.CharacterPreviewView android:id="@+id/characterPreview"
        android:layout_width="match_parent" android:layout_height="220dp"
        android:background="@drawable/card_bg" android:layout_margin="16dp"/>

    <!-- Model Toggle -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="16dp">
        <ImageButton android:id="@+id/btnSteve" android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/steve_head" android:background="@drawable/menu_item_bg"
            android:scaleType="fitCenter" android:padding="8dp" android:contentDescription="Steve"/>
        <ImageButton android:id="@+id/btnAlex" android:layout_width="80dp" android:layout_height="80dp"
            android:src="@drawable/alex_head" android:background="@android:color/transparent"
            android:scaleType="fitCenter" android:padding="8dp" android:layout_marginStart="24dp" android:contentDescription="Alex"/>
    </LinearLayout>

    <!-- List -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Your Accounts" android:textColor="@color/text" android:textSize="18sp"
        android:textStyle="bold" android:paddingHorizontal="16dp" android:paddingBottom="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/accountsRecyclerView"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingHorizontal="16dp"/>
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No accounts" android:gravity="center" android:textColor="@color/text_muted"
        android:padding="24dp" android:visibility="gone"/>

    <!-- Add Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/btnAddAccount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add" app:backgroundTint="@color/primary"
        app:tint="@color/white"/>
</LinearLayout>
