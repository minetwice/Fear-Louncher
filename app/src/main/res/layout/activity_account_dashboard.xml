<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/sidebar_bg"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Account Dashboard"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- 3-Line Menu Button -->
        <ImageView
            android:id="@+id/btnMenuOptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/text"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- 3D Character Preview -->
    <com.fearlauncher.app.view.CharacterPreviewView
        android:id="@+id/characterPreview"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@color/sidebar_bg"
        android:layout_margin="16dp"/>

    <!-- Model Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnSteve"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text="Steve (Classic)"
            android:textSize="12sp"
            android:background="@drawable/menu_item_bg"
            android:textColor="@color/primary"/>

        <Button
            android:id="@+id/btnAlex"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text="Alex (Slim)"
            android:textSize="12sp"
            android:background="@android:color/transparent"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <!-- Account List -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Accounts"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/accountsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"/>

    <!-- Add Account Button -->
    <Button
        android:id="@+id/btnAddAccount"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="+ Create New Account"
        android:textColor="@color/black"
        android:background="@drawable/button_primary_bg"
        android:layout_margin="16dp"/>
</LinearLayout>
