<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="horizontal"

    android:background="@drawable/bg_main">

    <!-- SIDEBAR -->

    <LinearLayout
        android:layout_width="90dp"
        android:layout_height="match_parent"

        android:orientation="vertical"

        android:padding="12dp"

        android:background="@drawable/sidebar_bg">

        <!-- LOGO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="FL"

            android:textColor="@color/primary"

            android:textStyle="bold"

            android:textSize="30sp"/>

        <!-- MENU -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="30dp"

            android:orientation="vertical">

            <!-- HOME -->

            <Button
                android:id="@+id/homeButton"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:text="Home"

                android:textStyle="bold"

                android:textColor="@color/black"

                android:background="@drawable/play_button_bg"/>

            <!-- PLAY -->

            <Button
                android:id="@+id/playMenuButton"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:layout_marginTop="12dp"

                android:text="Play"

                android:textColor="@color/text"

                android:background="@drawable/card_bg"/>

            <!-- INSTALL -->

            <Button
                android:id="@+id/installButton"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:layout_marginTop="12dp"

                android:text="Install"

                android:textColor="@color/text"

                android:background="@drawable/card_bg"/>

            <!-- MODS -->

            <Button
                android:id="@+id/modsButton"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:layout_marginTop="12dp"

                android:text="Mods"

                android:textColor="@color/text"

                android:background="@drawable/card_bg"/>

            <!-- SETTINGS -->

            <Button
                android:id="@+id/settingsButton"

                android:layout_width="match_parent"
                android:layout_height="55dp"

                android:layout_marginTop="12dp"

                android:text="Settings"

                android:textColor="@color/text"

                android:background="@drawable/card_bg"/>

        </LinearLayout>

    </LinearLayout>

    <!-- MAIN CONTENT -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="20dp">

            <!-- WELCOME -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Welcome Back"

                android:textColor="@color/text"

                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="FearUser!"

                android:textColor="@color/primary"

                android:textStyle="bold"

                android:textSize="34sp"/>

            <!-- VERSION CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"

                android:layout_marginTop="24dp"

                android:background="@drawable/version_card_bg"

                android:gravity="center_vertical"

                android:padding="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Latest Version"

                        android:textColor="@color/subtext"

                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="1.21.5"

                        android:textColor="@color/primary"

                        android:textStyle="bold"

                        android:textSize="26sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- MAIN CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"

                android:layout_marginTop="24dp"

                android:orientation="vertical"

                android:padding="20dp"

                android:background="@drawable/card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="MINECRAFT"

                    android:textColor="@color/text"

                    android:textStyle="bold"

                    android:textSize="38sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="YOUR WORLD YOUR ADVENTURE"

                    android:textColor="@color/primary"

                    android:textStyle="bold"

                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:text="Play Minecraft Java Edition on Android with smooth performance and advanced launcher support."

                    android:textColor="@color/subtext"

                    android:textSize="14sp"/>

                <!-- PLAY BUTTON -->

                <Button
                    android:id="@+id/playButton"

                    android:layout_width="190dp"
                    android:layout_height="60dp"

                    android:layout_marginTop="30dp"

                    android:text="PLAY NOW"

                    android:textStyle="bold"

                    android:textColor="@color/black"

                    android:background="@drawable/play_button_bg"/>

            </LinearLayout>

            <!-- QUICK ACTIONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                android:orientation="horizontal">

                <!-- MODS CARD -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="140dp"

                    android:layout_weight="1"

                    android:layout_marginEnd="8dp"

                    android:orientation="vertical"

                    android:padding="18dp"

                    android:background="@drawable/card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Mods"

                        android:textColor="@color/text"

                        android:textStyle="bold"

                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="Manage Fabric & Forge mods"

                        android:textColor="@color/subtext"/>

                </LinearLayout>

                <!-- SETTINGS CARD -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="140dp"

                    android:layout_weight="1"

                    android:layout_marginStart="8dp"

                    android:orientation="vertical"

                    android:padding="18dp"

                    android:background="@drawable/card_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Settings"

                        android:textColor="@color/text"

                        android:textStyle="bold"

                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="Controls, Java & Renderer"

                        android:textColor="@color/subtext"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
