<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_animated">

    <!-- Animated Background Overlay -->
    <com.fearlauncher.app.view.AnimatedBackgroundView
        android:id="@+id/bgAnimated"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Top Bar with Hamburger Menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:background="#20000000">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FEAR"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_menu"
            android:background="@drawable/btn_glass"
            android:contentDescription="Menu"
            android:tint="@color/text"
            android:stateListAnimator="@animator/btn_bubble"/>
    </LinearLayout>

    <!-- Clean Dashboard Center -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛏️"
            android:textSize="64sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to FearLauncher"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap menu to explore versions"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Bottom Thin Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:background="#20000000"
        android:paddingHorizontal="8dp">

        <com.fearlauncher.app.view.GlassButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:icon="@drawable/ic_home"
            app:label="Home"
            android:stateListAnimator="@animator/btn_bubble"/>

        <com.fearlauncher.app.view.GlassButton
            android:id="@+id/btnVersions"            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:icon="@drawable/ic_version"
            app:label="Versions"
            android:stateListAnimator="@animator/btn_bubble"/>
    </LinearLayout>

    <!-- Side Panel (Hidden by Default) -->
    <include
        android:id="@+id/sidePanel"
        layout="@layout/panel_side_menu"
        android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
