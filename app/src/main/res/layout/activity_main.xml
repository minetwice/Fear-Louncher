<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_dashboard_gradient">

    <!-- ✅ LEFT SIDEBAR PANEL -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/sidebar_bg"
        android:paddingTop="20dp"
        android:gravity="center_horizontal">

        <!-- Home Icon -->
        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_menu_compass"
            android:background="@drawable/btn_sidebar_item"
            android:scaleType="fitCenter"
            android:tint="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <!-- Versions Icon -->
        <ImageButton
            android:id="@+id/nav_versions"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@drawable/btn_sidebar_item"
            android:scaleType="fitCenter"
            android:tint="#AAAAAA"
            android:layout_marginBottom="20dp"/>

        <!-- Settings Icon -->
        <ImageButton
            android:id="@+id/nav_settings"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="@drawable/btn_sidebar_item"
            android:scaleType="fitCenter"
            android:tint="#AAAAAA"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
    <!-- ✅ RIGHT DASHBOARD AREA -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINECRAFT: JAVA EDITION"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentTop="true"
            android:layout_marginTop="10dp"/>

        <!-- Main Content Placeholder (Image/News) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@id/play_container"
            android:layout_below="@id/header_text"
            android:layout_marginVertical="20dp"
            android:background="#1AFFFFFF"/> 
            <!-- You can add an ImageView here later for news banner -->

        <!-- Bottom Play Area -->
        <LinearLayout
            android:id="@+id/play_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_version_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latest Release: 1.21.1"
                android:textColor="#AAAAAA"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_play_big"
                android:layout_width="300dp"
                android:layout_height="60dp"                android:text="PLAY"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_play_epic"
                android:elevation="8dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to launch"
                android:textColor="#4CAF50"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
