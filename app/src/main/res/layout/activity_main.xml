<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_launcher_dark">

    <!-- ✅ LEFT SIDEBAR (Like PC Launcher) -->
    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/sidebar_bg"
        android:gravity="center_horizontal"
        android:paddingTop="10dp">

        <!-- Home Icon -->
        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_compass"
            android:background="@drawable/btn_sidebar_item"
            android:tint="#AAAAAA"
            android:scaleType="fitCenter"
            android:layout_marginBottom="10dp"/>

        <!-- Versions Icon -->
        <ImageButton
            android:id="@+id/nav_versions"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@drawable/btn_sidebar_item"
            android:tint="#AAAAAA"
            android:scaleType="fitCenter"
            android:layout_marginBottom="10dp"/>

        <!-- Settings Icon -->
        <ImageButton
            android:id="@+id/nav_settings"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="@drawable/btn_sidebar_item"
            android:tint="#AAAAAA"
            android:scaleType="fitCenter"/>

    </LinearLayout>
    <!-- ✅ MAIN CONTENT AREA -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- ✅ HEADER TEXT (This was missing!) -->
        <TextView
            android:id="@+id/header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINECRAFT: JAVA EDITION"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_alignParentTop="true"
            android:layout_margin="20dp"/>

        <!-- Banner Image Placeholder -->
        <View
            android:id="@+id/banner_placeholder"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@id/header_text"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:background="#333333"/> 

        <!-- Bottom Play Bar -->
        <LinearLayout
            android:id="@+id/play_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to play"
                android:textColor="#4CAF50"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_play_big"
                android:layout_width="300dp"
                android:layout_height="50dp"                android:text="PLAY"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_play_minecraft"/>
                
            <TextView
                android:id="@+id/tv_version_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latest Release"
                android:textColor="#AAAAAA"
                android:layout_marginTop="5dp"/>
        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
