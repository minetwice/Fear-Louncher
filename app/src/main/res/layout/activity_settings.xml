<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_animated"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <com.fearlauncher.app.view.GlassButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@android:drawable/ic_menu_revert"
            app:label=""
            app:thin="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️ Settings"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- Java Version Selector -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#1AFFFFFF"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☕ Java Runtime Version"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Java version for Minecraft:"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <RadioGroup
                android:id="@+id/javaVersionGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioJava8"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Java 8 (Recommended for 1.16.5 and below)"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"/>

                <RadioButton
                    android:id="@+id/radioJava17"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Java 17 (Recommended for 1.17 - 1.20.4)"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/radioJava21"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Java 21 (Recommended for 1.20.5+)"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"/>

                <RadioButton
                    android:id="@+id/radioJava25"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Java 25 (Latest - Experimental)"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"/>
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#30FFFFFF"
                android:layout_marginVertical="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Tip: Newer Minecraft versions need newer Java"
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Save Button -->
    <com.fearlauncher.app.view.GlassButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:label="💾 Save Settings"
        app:thin="true"
        android:stateListAnimator="@animator/btn_bubble"/>

</LinearLayout>
