<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FearLouncher.Epic" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Background -->
        <item name="android:windowBackground">@drawable/bg_gradient_animated</item>
        
        <!-- Status/Nav Bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@anim/bubble_enter</item>
        <item name="android:windowExitTransition">@anim/bubble_exit</item>
    </style>
</resources>
