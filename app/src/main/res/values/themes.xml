<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FearLouncher.Epic" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#00ADB5</item>
        <item name="colorPrimaryVariant">#007B83</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#FF4081</item>
        <item name="colorSecondaryVariant">#C2185B</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        
        <!-- Background -->
        <item name="android:windowBackground">@drawable/bg_epic_gradient</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
